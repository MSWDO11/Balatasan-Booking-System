rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@gmail.com' || 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // --- COLLECTION RULES ---

    // Public catalog (Read) - Admin (Write)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — anyone can read, only signed-in users can write their own review
    match /reviews/{itemKey}/entries/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // CollectionGroup read for reviews (admin dashboard)
    match /{path=**}/entries/{entryId} {
      allow read: if true;
    }

    // Global access to bookings for admins (Support for Collection Group Queries)
    match /{path=**}/bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    // User-specific booking rules
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.userId == userId;
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // User notifications — only the user can read their own
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // Admin role management
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.token.email == 'admin@gmail.com' && request.auth.uid == adminId);
      allow update, delete: if isSignedIn() && request.auth.token.email == 'admin@gmail.com';
    }

    // Settings — public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}